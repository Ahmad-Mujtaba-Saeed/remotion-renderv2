   "duration_seconds": 10,
   "narration": {
    "text": "Squaring a bracket is not squaring each term. You have to multiply it out; the cross term is the piece people drop."
   },
   "layout_template": "common_mistake",
   "transition": "none",
   "slots": {
    "slot_mistake": {
     "content_type": "mistake",
     "wrong": "(x+3)^2 = x^2 + 9",
     "correct": "(x+3)^2 = x^2 + 6x + 9",
     "why": "The cross term 6x is what the bracket actually produces."
    }
   }
  },
  {
   "scene_id": "cm3",
   "order": 3,
